* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.spec text eol=lf
*.iss text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=lf

*.cer binary
*.zip binary

# Preserve PDF byte offsets and embedded Office/image data across Windows checkouts.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary

# Preserve supplier records and notices byte-for-byte for their SHA-256 catalogs.
compliance/source-records/** -text
app/resources/licenses/** -text
compliance/runtime-dependencies.lock.json -text
